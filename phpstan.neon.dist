parameters:
	level: 6
	# From Requires PHP to the newest PHP release.
	phpVersion:
		min: 70400
		max: 80599
	paths:
		- modal-kit.php
		- includes
	bootstrapFiles:
		- tests/phpstan/bootstrap.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	treatPhpDocTypesAsCertain: false
