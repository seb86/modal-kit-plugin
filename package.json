{
	"name": "modal-kit",
	"version": "0.1.0-preview-1",
	"requires": "6.8",
	"requires_php": "7.4",
	"tested_up_to": "7.1",
	"private": true,
	"description": "Modals made of blocks.",
	"author": "Sébastien Dumont",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"modal-kit.php",
		"uninstall.php",
		"readme.txt",
		"includes",
		"build",
		"assets",
		"schema",
		"patterns",
		"languages",
		"src"
	],
	"scripts": {
		"env:start": "node bin/env.mjs start",
		"env:status": "node bin/env.mjs status",
		"env:wp": "node bin/env.mjs wp",
		"demos": "node bin/env.mjs wp eval-file bin/demos.php",
		"prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bin/build-styles.mjs",
		"prestart": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bin/build-styles.mjs",
		"build": "wp-scripts build --experimental-modules --webpack-src-dir=src --output-path=build",
		"start": "wp-scripts start --experimental-modules --webpack-src-dir=src --output-path=build",
		"format": "wp-scripts format src tests bin",
		"lint": "npm run lint:js && npm run lint:style && npm run lint:php",
		"lint:js": "wp-scripts lint-js .",
		"lint:style": "wp-scripts lint-style \"src/**/*.scss\" --allow-empty-input",
		"lint:php": "composer run lint",
		"lint:phpstan": "composer run phpstan",
		"test:unit": "npm run test:js && npm run test:php",
		"test:js": "vitest run",
		"test:php": "node bin/phpunit.mjs",
		"test:multisite": "node bin/phpunit.mjs --multisite",
		"test:e2e": "node bin/env.mjs check && wp-scripts test-playwright",
		"test:static": "node bin/test-static.mjs",
		"test:browsers": "node bin/env.mjs check && wp-scripts test-playwright --config tests/browsers/playwright.config.js",
		"test:themes": "node bin/test-themes.mjs",
		"plugin-zip": "wp-scripts plugin-zip && node bin/release-zip.mjs",
		"version": "node bin/version.mjs",
		"stable": "node bin/version.mjs --stable",
		"zip": "npm run version && npm run build && npm run i18n:pot && npm run plugin-zip",
		"ready": "npm run version && npm run stable && npm run build && npm run i18n:pot && npm run plugin-zip",
		"wporg:screenshots": "node bin/wporg-screenshots.cjs",
		"wporg:blueprint": "node bin/blueprint.mjs",
		"i18n:pot": "node bin/env.mjs wp i18n make-pot . languages/modal-kit.pot --slug=modal-kit --domain=modal-kit --exclude=node_modules,vendor,src,tests,bin,artifacts"
	},
	"dependencies": {
		"@wordpress/a11y": "^5.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/html-entities": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/interactivity": "^8.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/primitives": "^5.0.0",
		"@wordpress/url": "^5.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/scripts": "^37.0.0",
		"jsdom": "^30.1.3",
		"vitest": "^5.0.5"
	}
}
