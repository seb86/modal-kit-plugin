# Copy to .env. Points the tools at the local Laragon sites instead of wp-env.

# Laragon install folder.
LARAGON_PATH=C:/laragon

# PHP used for WP-CLI and PHPUnit (Laragon's PHP has mysqli).
PHP_BINARY=C:/laragon/bin/php/php-8.3.30-Win32-vs16-x64/php.exe

# Development site (plugins symlinked in).
WP_DEV_PATH=C:/laragon/www/modal-kit
WP_DEV_URL=http://localhost:8081

# Test site used by Playwright (@wordpress/scripts reads WP_BASE_URL).
WP_TESTS_PATH=C:/laragon/www/modal-kit-tests
WP_BASE_URL=http://localhost:8082

# WordPress PHPUnit library (includes/, data/, wp-tests-config.php).
WP_TESTS_DIR=C:/laragon/wp-tests/modal-kit
