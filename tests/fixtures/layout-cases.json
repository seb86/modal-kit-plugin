			"className": "is-style-harbor",
			"styleOptions": { "accent": "custom", "accentColor": "#FFCC00", "fonts": "style" }
		},
		"classes": [
			"modal-kit",
			"modal-kit--centered",
			"modal-kit--size-m",
			"modal-kit--m-centered",
			"modal-kit--anim-fade-rise",
			"has-overlay",
			"mk-style",
			"mk-style-harbor"
		],
		"style": "--modal-kit-overlay-opacity:0.45;--mk-accent:#ffcc00;--mk-accent-strong:color-mix(in srgb,#ffcc00 78%,var(--mk-ink));--mk-on-accent:#17151f;--mk-full-accent:#ffcc00;--mk-full-button:#ffcc00;--mk-on-full-button:#17151f"
	},
	{
		"name": "fixed style with the theme primary falls back to the style accent",
		"attributes": {
			"className": "is-style-fieldnote",
			"styleOptions": { "accent": "theme", "accentColor": "", "fonts": "style" }
		},
		"classes": [
			"modal-kit",
			"modal-kit--centered",
			"modal-kit--size-m",
			"modal-kit--m-centered",
			"modal-kit--anim-fade-rise",
			"has-overlay",
			"mk-style",
			"mk-style-fieldnote"
		],
		"style": "--modal-kit-overlay-opacity:0.45;--mk-accent:var(--modal-kit-primary,#5E45CD);--mk-accent-strong:color-mix(in srgb,var(--modal-kit-primary,#5E45CD) 78%,var(--mk-ink));--mk-on-accent:var(--modal-kit-on-primary,#FFFFFF);--mk-full-accent:var(--modal-kit-primary,#5E45CD);--mk-full-button:var(--modal-kit-primary,#5E45CD);--mk-on-full-button:var(--modal-kit-on-primary,#FFFFFF)"
	},
	{
		"name": "styles that follow the theme ignore the fixed-style options",
		"attributes": {
			"className": "is-style-soft",
			"styleOptions": { "accent": "custom", "accentColor": "#ffcc00", "fonts": "theme" }
		},
		"classes": [
			"modal-kit",
			"modal-kit--centered",
			"modal-kit--size-m",
			"modal-kit--m-centered",
			"modal-kit--anim-fade-rise",
			"has-overlay"
		],
		"style": "--modal-kit-overlay-opacity:0.45"
	},
	{
		"name": "a custom accent without a color keeps the style accent",
		"attributes": {
			"className": "is-style-night",
			"styleOptions": { "accent": "custom", "accentColor": "red" }
		},
		"classes": [
			"modal-kit",
			"modal-kit--centered",
			"modal-kit--size-m",
			"modal-kit--m-centered",
			"modal-kit--anim-fade-rise",
			"has-overlay",
			"mk-style",
			"mk-style-night"
		],
